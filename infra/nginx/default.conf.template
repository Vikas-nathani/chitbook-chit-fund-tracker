# Served by the "web" container. The nginx image fills ${API_UPSTREAM} and ${API_PORT}
# from the environment (.env) when the container starts.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Docker's DNS: re-resolve the api container if it is recreated with a new IP
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api http://${API_UPSTREAM}:${API_PORT};

    # Security headers: the API sets its own, so they are added only to the static app locations
    # below (nginx drops server-level add_header in any location that has its own add_header).

    # API + chat WebSocket. The browser talks to one origin, so no CORS is needed.
    location /api/ {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;  # keep chat sockets open
    }

    location /health {
        proxy_pass $api;
    }

    # Hashed build assets never change: cache for a long time
    location /_expo/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Client-side routes (/chits/12, /insights, ...) fall back to the app shell
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri $uri/ /index.html;
    }
}

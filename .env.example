# Copy to .env and fill in real values. Every variable is required; there are no defaults.

# ---------- General ----------
APP_ENV=development
TZ=Asia/Kolkata

# ---------- Docker network (fixed so pg_hba can allow it) ----------
DOCKER_SUBNET=172.29.0.0/24

# ---------- Postgres superuser (one-time setup only: scripts/setup-db.sh) ----------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
POSTGRES_SETUP_HOST=localhost

# ---------- App database ----------
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=chitbook
DB_TEST_NAME=chitbook_test
DB_USER=chitbook_app
DB_PASSWORD=change-me
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5

# ---------- API ----------
API_PORT=8080
API_WORKERS=2
API_DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3500,http://localhost:8081
FORWARDED_ALLOW_IPS=172.29.0.0/24

# ---------- Auth ----------
JWT_SECRET=change-me-generate-with-python-secrets-token_urlsafe-64
JWT_ISSUER=chitbook-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_SECURE=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_MINUTES=5
LOGIN_LOCKOUT_MAX_MINUTES=1440
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---------- Admin bootstrap (created on first start if missing) ----------
ADMIN_USERNAME=vikas
ADMIN_PASSWORD=change-me
ADMIN_NAME=Vikas
ADMIN_EMAIL=admin@chitfund.local

# ---------- Logging (JSON on stdout; Docker rotates it) ----------
LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ---------- Web (nginx serving the Expo web build) ----------
WEB_PORT=3500
API_UPSTREAM=api

# ---------- Mobile (read at build time by Expo) ----------
EXPO_PUBLIC_API_BASE_URL=http://34.14.197.155:8080

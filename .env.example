# Copy to .env and fill in real values. .env is gitignored.

# Timezone (IST) - used by JVM, MySQL, JDBC, Hibernate, Jackson and the containers
TZ=Asia/Kolkata
DB_TIMEZONE_OFFSET=+05:30

# MySQL container
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=chitfund
MYSQL_USER=chituser
MYSQL_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# Spring Boot datasource
SPRING_DATASOURCE_USERNAME=chituser
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# App
APP_NAME=chit
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default
JAVA_OPTS=-Xms256m -Xmx512m

# Admin account created on first start if it doesn't exist
ADMIN_USERNAME=vikas
ADMIN_PASSWORD=change-me
ADMIN_NAME=Vikas
ADMIN_EMAIL=admin@chitfund.local

# CORS
APP_CORS_ALLOWED_ORIGINS=*
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_ALLOW_CREDENTIALS=true

# Web (nginx) -> backend
BACKEND_HOST=app
BACKEND_PORT=8080

# Host ports
APP_PORT=8080
DB_HOST_PORT=3307
WEB_PORT=3500

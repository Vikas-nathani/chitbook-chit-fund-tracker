# Copy to .env and fill in real values. .env is gitignored.

# Database settings for local docker-compose
DB_HOST=db
DB_PORT=3306

# MySQL credentials
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=chitfund
MYSQL_USER=chituser
MYSQL_PASSWORD=change-me

# Spring Boot datasource
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/chitfund?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=chituser
SPRING_DATASOURCE_PASSWORD=change-me

# Admin account created on first start if it doesn't exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@chitfund.local

# Host ports
APP_PORT=8080
DB_HOST_PORT=3307
WEB_PORT=3500
